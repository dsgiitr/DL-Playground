	flatten_1_3 -> linear_1_4 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	linear_1_4 [label=<<b>linear_1_4</b><br/>1x10 (168 B)<br/>params: 10x28227, x10<br/>@layer_4> color=black fillcolor="#E6E6E6" fontcolor=black ordering=out shape=box style="filled,solid"]
	linear_1_4 -> output_1 [arrowsize=.7 color=black fontcolor=black labelfontsize=8 style=solid]
	output_1 [label=<<b>output_1</b><br/>1x10 (168 B)<br/>@output> color=black fillcolor="#ff9999" fontcolor=black ordering=out shape=oval style="filled,solid"]
	{
		rank=sink
